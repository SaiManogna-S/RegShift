# RegShift Backend Environment Variables
# Copy this file to .env and fill in your values

# LLM Configuration (OpenAI-compatible)
# If not provided, demo mode will be used for requirement extraction
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
# For Azure OpenAI or other providers, set:
# OPENAI_BASE_URL=https://your-endpoint.openai.azure.com/

# Database
DATABASE_URL=sqlite:///./regshift.db

# File storage
UPLOAD_DIR=./app/uploads
MAX_UPLOAD_SIZE_MB=20

# CORS - set to your frontend URL
FRONTEND_URL=http://localhost:5173

# Application
APP_ENV=development
SECRET_KEY=change-me-in-production
